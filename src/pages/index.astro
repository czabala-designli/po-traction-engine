---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import KindBadge from '../components/KindBadge.astro';
import AssetRelations from '../components/AssetRelations.astro';

const PHASES = [
  { slug: 'foundation', label: 'Foundation' },
  { slug: 'activation', label: 'Activation' },
  { slug: 'conversion', label: 'Conversion' },
  { slug: 'hdd', label: 'HDD Experiments' },
  { slug: 'marketing', label: 'Content & Growth' },
];

const BANDS = [
  {
    days: 'Days 1–30',
    title: 'The 30-day sprint',
    phases: ['foundation', 'activation', 'conversion'],
    dayRange: [1, 30],
  },
  {
    days: 'Days 31–90',
    title: 'HDD + Growth',
    phases: ['hdd', 'marketing'],
    dayRange: [31, 90],
  },
];

// The four commitment dates that anchor the 90-day engagement. Coral = hard guarantee,
// purple = promise / finish line. Shared by the overview section and the band milestones.
const COMMITMENTS = [
  { day: 14, label: 'Refund window closes', hint: 'Full refund, no questions. We show real progress on Basecamp first.', tag: 'guarantee', critical: true },
  { day: 30, label: 'First user', hint: 'A real human using the product (inner-circle counts).', tag: 'guarantee', critical: true },
  { day: 60, label: 'App store-ready (or scale-ready)', hint: 'App ready for store submission on mobile projects, or product ready to scale for non-mobile. Also the last day to give 30-day notice and still wind down by Day 90.', tag: 'last day to give notice', critical: false },
  { day: 90, label: 'First dollar of revenue', hint: 'End of the 90-day engagement. Renewals carry the next mission.', tag: 'engagement ends', critical: false },
];

const DAY0 = [
  'Founder-orbit users identified & personally committed — your guaranteed first users',
  'Founder domain confirmed — unblocks PostHog email (needed day 1)',
  'Apple Developer account / DUNS started, if mobile — takes days; start now',
  'Dev & staging environments confirmed with the tech lead',
];

const assets = await getCollection('assets');
const projects = await getCollection('projects');
const starter = assets.find((a) => a.data.starter);
const labelOf = Object.fromEntries(PHASES.map((p) => [p.slug, p.label]));
const titleOf = Object.fromEntries(assets.map((a) => [a.id, a.data.title]));

const relOf = (a: (typeof assets)[number]) => ({
  needs: [
    ...a.data.needs.map((id) => ({ id, title: titleOf[id] })).filter((n) => n.title),
    ...(a.data.needsNote ? [{ note: a.data.needsNote }] : []),
  ],
  feeds: a.data.feeds.map((id) => ({ id, title: titleOf[id] })).filter((n) => n.title),
});

// Live items sort ahead of coming-soon within a phase, so the usable path is always
// encountered first; order is the tie-breaker within each status.
const statusRank = (s: string) => (s === 'live' ? 0 : 1);
const itemsIn = (slug: string) =>
  assets
    .filter((a) => a.data.phase === slug)
    .sort((a, b) => statusRank(a.data.status) - statusRank(b.data.status) || a.data.order - b.data.order);

const bands = BANDS.map((b) => {
  const groups = b.phases
    .map((slug) => ({ slug, label: labelOf[slug], items: itemsIn(slug) }))
    .filter((g) => g.items.length > 0);
  const items = groups.flatMap((g) => g.items);
  const liveCount = items.filter((a) => a.data.status === 'live').length;
  // Flag a band whose live plays are outnumbered by planned ones, so we can frame it
  // honestly as a roadmap rather than let it read as a run of empty pages.
  const mostlyPlanned = items.length - liveCount > liveCount;
  return {
    ...b,
    milestones: COMMITMENTS.filter((c) => c.day >= b.dayRange[0] && c.day <= b.dayRange[1]),
    groups,
    mostlyPlanned,
  };
}).filter((b) => b.groups.length > 0);

const ctaFor = (kind: string) =>
  kind === 'template' ? 'View template →' : kind === 'tool' ? 'Open tool →' : 'View play →';
---
<Layout
  title="PO Traction Library — Designli"
  description="The 30/90-day TractionLab playbook for Designli POs — templates, plays, and tools in the order you run them."
>
  <nav class="sticky-nav">
    <div class="nav-logo">
      <img src="/designli-logo.png" alt="Designli" width="20" height="20" />
      <span class="nav-logo-label">Designli</span>
    </div>
    <span class="nav-title">PO Traction Library</span>
  </nav>

  <main class="page">
    <header class="intro">
      <p class="eyebrow">Internal · Designli POs</p>
      <h1 class="headline">The PO Traction Library.</h1>
      <p class="subtitle">
        The TractionLab playbook — the templates, plays, and tools a Product Owner
        runs across the 30/90-day engagement, in the order you run them.
      </p>
    </header>

    <a class="manifesto" href="https://hdd.designli.co/po-traction" target="_blank" rel="noopener">
      <div class="manifesto-top">
        <p class="manifesto-eyebrow">1 · Start with the why</p>
        <span class="manifesto-source" aria-hidden="true">External · hdd.designli.co</span>
      </div>
      <h2 class="manifesto-title">PO as Traction Engine <span class="manifesto-ext" aria-hidden="true">↗</span></h2>
      <p class="manifesto-body">
        The manifesto behind this playbook — why getting a product's first users is now the PO's job,
        the two tracks you'll run, and how HDD applies to distribution. Read this before you run a single play.
      </p>
      <span class="manifesto-cta">Read the manifesto on hdd.designli.co ↗</span>
      <span class="manifesto-note">
        The canonical version, hosted on Designli's HDD site. Opens in a new tab and may require a Designli Google sign-in.
      </span>
    </a>

    {starter && (
      <a class="start-here" href={`/library/${starter.id}`}>
        <span class="start-here-arrow" aria-hidden="true">▸</span>
        <span><strong>2 · Run your first play</strong> — the {starter.data.title}, your first traction experiment.</span>
      </a>
    )}

    <section class="day0">
      <p class="day0-eyebrow">Day 0 · Before you start</p>
      <p class="day0-lead">Lock these down from day zero — a slip on any of them blocks everything downstream.</p>
      <ul class="day0-list">
        {DAY0.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="commitments">
      <p class="commitments-eyebrow">What you're driving toward</p>
      <p class="commitments-lead">
        Four dates anchor the 90-day engagement. Two are hard guarantees (coral); the other
        two are the standing promise and the finish line.
      </p>
      <div class="commitments-grid">
        {COMMITMENTS.map((c) => (
          <div class:list={['commit-card', { 'commit-note': !c.critical }]}>
            <p class="commit-day">Day {c.day}</p>
            <p class="commit-label">{c.label}</p>
            <p class="commit-hint">{c.hint}</p>
            <span class:list={['commit-tag', c.critical ? 'is-guarantee' : 'is-note']}>{c.tag}</span>
          </div>
        ))}
      </div>
    </section>

    {bands.map((band) => (
      <section class="band">
        <div class="band-head">
          <span class="band-days">{band.days}</span>
          <h2 class="band-title">{band.title}</h2>
          {band.mostlyPlanned && (
            <p class="band-lead">
              Most of this track is still on the roadmap. The plays marked <strong>Live</strong> are
              ready to run now; the rest are planned and go live as they're built.
            </p>
          )}
        </div>

        {band.groups.map((g) => (
          <div class="subphase">
            <h3 class="subphase-title">{g.label}</h3>
            <div class="grid">
              {g.items.map((a) => (
                <div class:list={['card', a.data.status === 'live' ? 'card-live' : 'card-disabled']}>
                  <div class="badges"><KindBadge kind={a.data.kind} /><StatusBadge status={a.data.status} /></div>
                  <h4 class="card-title">{a.data.title}</h4>
                  <p class="card-summary">{a.data.summary}</p>
                  <AssetRelations needs={relOf(a).needs} feeds={relOf(a).feeds} />
                  {a.data.status === 'live' && (
                    <a class="card-cta card-cta-link" href={`/library/${a.id}`}>{ctaFor(a.data.kind)}</a>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}

        {band.milestones.length > 0 && (
          <div class="milestones">
            {band.milestones.map((m) => (
              <p class:list={['milestone', { 'milestone-note': !m.critical }]}>
                <span class="milestone-flag" aria-hidden="true">◆</span>
                <span><strong>Day {m.day} — {m.label}</strong> · {m.hint}</span>
              </p>
            ))}
          </div>
        )}
      </section>
    ))}

    <section class="band">
      <div class="band-head">
        <h2 class="band-title">Projects</h2>
        <p class="band-lead">
          Counts differ by design: the template lists the full 38-item kickoff checklist
          (the full mobile task map plus milestones), while a case study tracks a curated set of
          milestone markers. For the canonical day-by-day list, use the Task Map Generator.
        </p>
      </div>
      <div class="grid">
        {projects
          .slice()
          .sort((a, b) => Number(a.data.status === 'template') - Number(b.data.status === 'template'))
          .map((p) => {
            const done = p.data.checklist.filter((i) => i.done).length;
            const total = p.data.checklist.length;
            const isTemplate = p.data.status === 'template';
            return (
              <a class:list={['card', { 'card-template': isTemplate }]} href={`/projects/${p.id}`}>
                <StatusBadge status={p.data.status} />
                <h4 class="card-title">{p.data.title}</h4>
                <p class="card-summary">{p.data.summary}</p>
                {total > 0 && <p class="proj-progress">{done} / {total} complete</p>}
                <span class="card-cta">{isTemplate ? 'See the starting checklist →' : 'View case study →'}</span>
              </a>
            );
          })}
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <img src="/designli-logo.png" alt="" width="14" height="14" aria-hidden="true" />
    <span>Designli · 2026</span>
    <span class="sep">·</span>
    <span>Internal initiative</span>
    <span class="sep">·</span>
    <a href="/privacy">Privacy Policy</a>
    <span class="sep">·</span>
    <a href="/terms">Terms &amp; Conditions</a>
  </footer>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    window.posthog?.capture('page_viewed', { page: 'library-home' });
  });
</script>

<style>
  .sticky-nav {
    position: fixed; top: 0; left: var(--bar-w); right: 0; height: 52px;
    z-index: 200; display: flex; align-items: center; gap: 12px; padding: 0 20px;
    background: rgba(14, 16, 52, 0.92);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .nav-logo { display: flex; align-items: center; gap: 8px; }
  .nav-logo img { opacity: 0.9; object-fit: contain; }
  .nav-logo-label { font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted-blue); }
  .nav-title { font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--off-white); }

  .page { max-width: 960px; margin: 0 auto; padding: 96px calc(var(--bar-w) + 24px) 40px 24px; }
  .intro { margin-bottom: 44px; }
  .eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 0.35em; text-transform: uppercase; color: var(--coral); margin-bottom: 20px; }
  .headline { font-family: var(--serif); font-size: clamp(38px, 6vw, 68px); font-weight: 400; color: var(--white); line-height: 1.0; margin-bottom: 24px; }
  .subtitle { font-family: var(--serif); font-size: clamp(16px, 2vw, 20px); line-height: 1.65; color: var(--muted-blue); max-width: 640px; }

  .start-here {
    display: inline-flex; align-items: baseline; gap: 10px;
    margin-bottom: 48px; max-width: 640px; padding: 12px 16px;
    border: 1px solid rgba(248, 117, 101, 0.35); border-left: 3px solid var(--coral);
    border-radius: 6px; background: rgba(248, 117, 101, 0.06);
    color: var(--off-white); font-size: 14px; line-height: 1.6;
    text-decoration: none; transition: background 0.18s, border-color 0.18s;
  }
  .start-here:hover { background: rgba(248, 117, 101, 0.12); border-color: var(--coral); }
  .start-here strong { color: var(--coral); font-weight: 700; }
  .start-here-arrow { color: var(--coral); font-weight: 700; }

  /* Manifesto — the "why" (external HDD companion) */
  .manifesto {
    display: block; margin-bottom: 16px; padding: 26px 28px;
    background: var(--navy-card);
    border: 1px solid rgba(88, 55, 123, 0.55); border-left: 4px solid var(--purple);
    border-radius: 12px; text-decoration: none;
    transition: border-color 0.18s, transform 0.18s, background 0.18s;
  }
  .manifesto:hover { border-color: var(--purple); background: rgba(88, 55, 123, 0.14); transform: translateY(-3px); }
  .manifesto-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .manifesto-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; color: var(--purple-light, #A78BC4); margin-bottom: 0; }
  /* Explicit external-source marker — this content lives on a separate Designli property. */
  .manifesto-source {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--purple-light, #A78BC4); background: rgba(88, 55, 123, 0.28);
    border: 1px solid rgba(88, 55, 123, 0.6); border-radius: 6px; padding: 3px 8px;
  }
  .manifesto-note { display: block; margin-top: 10px; font-size: 11.5px; line-height: 1.5; color: var(--muted-blue); font-style: italic; }
  .manifesto-title { font-family: var(--serif); font-size: clamp(22px, 3vw, 30px); font-weight: 400; color: var(--white); line-height: 1.15; margin-bottom: 12px; }
  .manifesto-ext { font-size: 0.6em; color: var(--purple-light, #A78BC4); vertical-align: super; }
  .manifesto-body { font-size: 14px; line-height: 1.7; color: var(--muted-blue); max-width: 680px; margin-bottom: 16px; }
  .manifesto-cta { font-size: 12px; font-weight: 700; letter-spacing: 0.05em; color: var(--purple-light, #A78BC4); }

  /* Day 0 — critical blockers */
  .day0 {
    margin-bottom: 48px; padding: 22px 24px;
    border: 1px solid rgba(248, 117, 101, 0.35); border-left: 4px solid var(--coral);
    border-radius: 10px; background: rgba(248, 117, 101, 0.06);
  }
  .day0-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--coral); margin-bottom: 10px; }
  .day0-lead { font-size: 14px; line-height: 1.6; color: var(--off-white); margin-bottom: 14px; }
  .day0-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .day0-list li { position: relative; padding-left: 20px; font-size: 13.5px; line-height: 1.55; color: var(--off-white); }
  .day0-list li::before { content: '▸'; position: absolute; left: 0; color: var(--coral); font-weight: 700; }

  /* Milestone bands */
  .band { margin-bottom: 40px; }
  .band-head { border-top: 2px solid var(--coral); padding-top: 18px; margin-bottom: 28px; }
  .band-days { font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--coral); }
  .band-title { font-family: var(--serif); font-size: clamp(24px, 3.4vw, 34px); font-weight: 400; color: var(--white); line-height: 1.1; margin-top: 4px; }
  .band-lead { font-size: 13.5px; line-height: 1.65; color: var(--muted-blue); max-width: 640px; margin-top: 12px; }
  .band-lead strong { color: var(--off-white); font-weight: 700; }

  .subphase { margin-bottom: 32px; }
  .subphase-title { font-size: 12px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted-blue); margin-bottom: 16px; }

  .milestones { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
  .milestone {
    display: flex; align-items: baseline; gap: 10px;
    font-size: 13px; font-weight: 400; color: var(--coral);
    background: rgba(248, 117, 101, 0.08);
    border: 1px dashed rgba(248, 117, 101, 0.4);
    border-radius: 8px; padding: 12px 16px;
  }
  .milestone strong { font-weight: 700; }
  .milestone-flag { font-size: 11px; }
  /* Day 60 / 90 markers — promise & finish line, purple to sit below the coral guarantees. */
  .milestone-note {
    color: var(--purple-light, #A78BC4);
    background: rgba(88, 55, 123, 0.12);
    border-color: rgba(88, 55, 123, 0.45);
  }

  /* Commitment-dates overview — mirrors the Task Map Generator's guarantee cards. */
  .commitments { margin-bottom: 48px; }
  .commitments-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--coral); margin-bottom: 10px; }
  .commitments-lead { font-size: 14px; line-height: 1.6; color: var(--muted-blue); margin-bottom: 18px; max-width: 640px; }
  .commitments-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .commit-card {
    display: flex; flex-direction: column; gap: 6px;
    background: var(--navy-card); border: 1px solid var(--navy-mid);
    border-left: 3px solid var(--coral); border-radius: 10px; padding: 16px 16px 18px;
  }
  .commit-card.commit-note { border-left-color: var(--purple); }
  .commit-day { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-blue); }
  .commit-label { font-family: var(--serif); font-size: 16px; color: var(--white); line-height: 1.2; }
  .commit-hint { font-size: 12px; line-height: 1.55; color: var(--muted-blue); }
  .commit-tag { display: inline-block; align-self: flex-start; margin-top: 4px; font-size: 9px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 6px; padding: 2px 7px; border: 1px solid transparent; }
  .commit-tag.is-guarantee { color: var(--white); background: var(--coral); border-color: var(--coral); }
  .commit-tag.is-note { color: var(--purple-light, #A78BC4); background: rgba(88, 55, 123, 0.25); border-color: rgba(88, 55, 123, 0.6); }
  @media (max-width: 900px) { .commitments-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .commitments-grid { grid-template-columns: 1fr; } }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; } }

  .card {
    position: relative;
    display: flex; flex-direction: column; gap: 10px;
    background: var(--navy-card); border: 1px solid var(--navy-mid);
    border-radius: 10px; padding: 22px; text-decoration: none;
    transition: border-color 0.18s, transform 0.18s;
  }
  a.card:hover, .card-live:hover { border-color: var(--coral); transform: translateY(-3px); }
  .card-live { cursor: pointer; }
  .card-disabled { opacity: 0.55; }
  /* Stretched link: the CTA anchor covers the whole card so any non-link area navigates,
     while the Needs/Feeds tag links sit above it (z-index) and stay independently clickable. */
  .card-cta-link { text-decoration: none; }
  .card-cta-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .card :global(.rel a) { position: relative; z-index: 2; }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .card-title { font-family: var(--serif); font-size: 19px; font-weight: 400; color: var(--white); line-height: 1.25; margin-top: 4px; }
  .card-summary { font-size: 13px; line-height: 1.7; color: var(--muted-blue); }
  .card-cta { font-size: 12px; font-weight: 700; letter-spacing: 0.05em; color: var(--coral); margin-top: auto; padding-top: 10px; }
  .proj-progress { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-blue); margin-top: 4px; }
  .card-template { border-style: dashed; border-color: rgba(139, 143, 191, 0.4); }
  a.card-template:hover { border-color: var(--muted-blue); }

  .site-footer {
    max-width: 960px; margin: 0 auto;
    padding: 24px calc(var(--bar-w) + 24px) 36px 24px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-size: 12px; color: var(--muted-blue);
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .site-footer img { opacity: 0.4; }
  .sep { opacity: 0.35; }
  .site-footer a { color: var(--muted-blue); text-decoration: none; }
  .site-footer a:hover { color: var(--coral); }

  @media (max-width: 640px) {
    .page { padding-left: calc(var(--bar-w) + 16px); padding-right: 16px; }
  }
</style>
