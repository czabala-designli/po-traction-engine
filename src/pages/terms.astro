<style>
  main {
    padding: 5rem 1.5rem 4rem;
    padding-left: calc(1.5rem + 5px);
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.75;
  }

  .back {
    display: inline-block;
    color: var(--muted-blue);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .back:hover { color: var(--coral); }

  h1 {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--off-white);
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--coral);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  p {
    color: var(--off-white);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  ul {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
    color: var(--off-white);
    font-size: 0.95rem;
  }

  li { margin-bottom: 0.4rem; }

  a {
    color: var(--coral);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  .effective-date {
    color: var(--muted-blue);
    font-size: 0.85rem;
    margin-top: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--navy-mid);
    font-size: 0.875rem;
    color: var(--muted-blue);
  }

  .footer-links a {
    color: var(--muted-blue);
  }
  .footer-links a:hover { color: var(--coral); }
</style>
